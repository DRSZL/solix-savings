# ── Tibber ────────────────────────────────────────────────────────────────
# Get your token at: https://developer.tibber.com/settings/access-token
TIBBER_TOKEN=your-tibber-api-token-here

# ── Anker Solix ───────────────────────────────────────────────────────────
# Your Anker app login credentials
ANKER_EMAIL=your-anker-email@example.com
ANKER_PASSWORD=your-anker-password

# ── PV Panel Configuration ────────────────────────────────────────────────
# Maximum watt-peak per panel string (set unused strings to 0)
PV1_MAX_W=450
PV2_MAX_W=450
PV3_MAX_W=400
PV4_MAX_W=0

# Correction factor for real-world vs. rated output (0.0–1.0)
PV_PEAK_FACTOR=0.6

# ── Polling Intervals ─────────────────────────────────────────────────────
ANKER_INTERVAL_S=15
GOE_INTERVAL_S=15
TIBBER_INTERVAL_MIN=15
DASHBOARD_REFRESH_S=15
